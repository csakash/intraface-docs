{
  "name": "intraface-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --port ${PORT:-4103}",
    "build": "astro build && node scripts/headers.mjs && node scripts/check-build.mjs",
    "preview": "wrangler dev --port ${PORT:-4103}",
    "check": "astro check",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2",
    "github-slugger": "^2.0.0",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "0.12.0",
    "starlight-openapi": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
