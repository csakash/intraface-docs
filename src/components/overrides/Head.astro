---
import Default from '@astrojs/starlight/components/Head.astro';
import { crumbsFor } from '../../lib/crumbs';
import { mdUrl } from '../../lib/md';

const { entry } = Astro.locals.starlightRoute;
const site = Astro.site?.origin ?? 'https://intraface.cc';
const url = new URL(Astro.url.pathname, site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = Astro.url.pathname === `${base}/`;
const publisher = { '@type': 'Organization', name: 'Intraface', url: 'https://intraface.cc', logo: `${site}/docs/favicon.svg` };

// Only levels that are pages (a BreadcrumbList item must be a real URL).
const crumbs = crumbsFor(Astro.url.pathname, entry.data.title, base)
  .filter((c) => c.href)
  .map((c) => ({ name: c.label, item: `${site}${c.href}` }));

const graph: object[] = [
  {
    '@type': 'TechArticle',
    headline: entry.data.title,
    description: entry.data.description,
    url,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Intraface Docs', url: `${site}${base}/` },
    author: publisher,
    publisher,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  },
];
if (isHome) {
  graph.push({
    '@type': 'WebSite',
    name: 'Intraface Docs',
    url: `${site}${base}/`,
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}${base}/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  });
}
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<Default />
<link rel="alternate" type="text/markdown" href={mdUrl(Astro.url.pathname)} title="This page as Markdown" />
<script is:inline type="application/ld+json" set:html={ld} />
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', 'G-RL6C0MBP9C');
  // gtag.js loads after the page (and when the browser is idle) so it never competes with first paint.
  addEventListener(
    'load',
    () =>
      (window.requestIdleCallback || setTimeout)(
        () => {
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RL6C0MBP9C';
          document.head.appendChild(s);
        },
        { timeout: 3000 },
      ),
    { once: true },
  );
</script>
