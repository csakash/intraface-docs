---
import { mdUrl } from '../../lib/md';
import Pagination from './Pagination.astro';
---

<footer class="ifc-footer">
  <Pagination />
  <div class="foot">
    <a href={mdUrl(Astro.url.pathname)} data-show-md>View as Markdown</a>
    <span aria-hidden="true">·</span>
    <a href="https://github.com/csakash/intraface-docs">Source on GitHub</a>
    <span class="was" data-was role="group" aria-label="Was this page useful?">
      <span data-was-q role="status">Was this useful?</span>
      <button type="button" data-was-value="yes">Yes</button>
      <button type="button" data-was-value="no">No</button>
    </span>
  </div>
</footer>
<div class="toast" id="ifc-toast" role="status" aria-live="polite"></div>

<script>
  const toast = document.getElementById('ifc-toast') as HTMLElement;
  let timer = 0;
  document.addEventListener('ifc:toast', (e) => {
    toast.textContent = String((e as CustomEvent).detail);
    toast.classList.add('on');
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('on'), 1600);
  });
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-was-value]')) {
    b.addEventListener('click', () => {
      if (b.getAttribute('aria-disabled') === 'true') return;
      // Only the page path and the answer: nothing about the reader.
      const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
      gtag?.('event', 'docs_feedback', { page: location.pathname, value: b.dataset.wasValue });
      // Keep the buttons (and focus) where they are; the status line announces the thanks.
      const was = b.closest('[data-was]');
      const q = was?.querySelector('[data-was-q]');
      if (q) q.textContent = 'Thanks for telling us.';
      // aria-disabled, not disabled: a disabled button drops focus to <body>.
      for (const x of was?.querySelectorAll<HTMLButtonElement>('button') ?? []) {
        x.setAttribute('aria-disabled', 'true');
        x.setAttribute('aria-pressed', String(x === b));
      }
    });
  }
</script>

<style>
  .ifc-footer {
    margin-top: 3rem;
  }
  .foot {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 12px;
    color: var(--dim);
    align-items: center;
  }
  .foot a {
    color: var(--dust);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--chalk);
  }
  .was {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    margin-left: auto;
  }
  .was span {
    margin-right: 4px;
  }
  .was button {
    height: 26px;
    padding: 0 9px;
    border: 1px solid var(--seam);
    border-radius: 2px;
    font: inherit;
    font-size: 12px;
    color: var(--dust);
    background: var(--felt);
    cursor: pointer;
  }
  .was button:hover:not([aria-disabled='true']) {
    color: var(--chalk);
    border-color: var(--seam-2);
  }
  .was button[aria-disabled='true'] {
    cursor: default;
    opacity: 0.6;
  }
  .was button[aria-pressed='true'] {
    opacity: 1;
    color: var(--chalk);
    border-color: var(--thread);
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 22px;
    transform: translate(-50%, 20px);
    opacity: 0;
    z-index: 1100;
    background: var(--thread);
    color: var(--on-thread);
    font-size: 13px;
    padding: 9px 14px;
    border-radius: 3px;
    box-shadow: var(--shadow-pop);
    transition:
      opacity 200ms,
      transform 300ms var(--ease-expo);
    pointer-events: none;
  }
  .toast:global(.on) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (max-width: 50rem) {
    .was {
      margin-left: 0;
    }
  }
</style>
