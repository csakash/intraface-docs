---
const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(base.length).split('/').filter(Boolean);
const LABELS: Record<string, string> = { reference: 'Reference', api: 'HTTP API', operations: 'Operations' };
// Breadcrumbs: Docs / <section> / … / this page (sections link only where a page exists).
const crumbs = [{ label: 'Docs', href: `${base}/` }];
if (rest[0] === 'reference') crumbs.push({ label: 'Reference', href: '' });
if (rest[0] === 'reference' && rest[1] === 'api' && rest.length > 2)
  crumbs.push({ label: LABELS.api as string, href: `${base}/reference/api/` });
---

<nav class="crumbs" aria-label="Breadcrumb">
  {
    crumbs.map((c) => (
      <>
        {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        <span aria-hidden="true">/</span>
      </>
    ))
  }
  <span aria-current="page">{title}</span>
</nav>
<h1 id="_top">{title}</h1>
{description && <p class="lede">{description}</p>}
<div class="meta">
  <span class="chip"><span class="dot"></span>CLI 0.3.0 · MCP · API v1</span>
  <a href="#" data-show-md>View as Markdown</a>
  {
    route.editUrl && (
      <a href={route.editUrl.href} rel="noopener">
        Edit on GitHub
      </a>
    )
  }
</div>
<section id="agent-view" class="agent-view" aria-label="This page as Markdown">
  <div class="av-bar">
    <b>GET {Astro.url.pathname.replace(/\/$/, '') || '/docs'}.md</b><span data-md-meta>text/markdown</span><span class="sp"
    ></span><button type="button" class="btn" data-copy-md>Copy Markdown</button>
  </div>
  <pre class="md"></pre>
</section>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font: 500 11.5px/1 var(--f-mono);
    color: var(--dim);
    margin: 1rem 0 20px;
  }
  .crumbs a {
    text-decoration: none;
    color: var(--dust);
  }
  .crumbs a:hover {
    color: var(--chalk);
  }
  h1 {
    font: 600 var(--sl-text-h1) / 1.02 var(--f-display);
    letter-spacing: -0.045em;
    color: var(--chalk);
    margin: 0 0 16px;
    overflow-wrap: anywhere;
  }
  .lede {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--dust);
    margin: 0 0 22px;
    max-width: 620px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    font-size: 12.5px;
    color: var(--dust);
    padding-bottom: 22px;
    border-bottom: 1px dashed var(--line);
  }
  .meta a {
    color: var(--dust);
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--chalk);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0 8px;
    border-radius: 2px;
    font-size: 12px;
    color: var(--ok);
    background: var(--felt-2);
    border: 1px solid var(--seam);
    white-space: nowrap;
  }
  .chip .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .agent-view {
    display: none;
    margin-top: 24px;
  }
  :global([data-view='agent']) .agent-view {
    display: block;
  }
  :global([data-view='agent'] .sl-markdown-content),
  :global([data-view='agent'] .ifc-footer) {
    display: none !important;
  }
  .av-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 10px 14px;
    border: 1px solid var(--seam);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: var(--felt);
    font: 400 12px/1.4 var(--f-mono);
    color: var(--dust);
  }
  .av-bar b {
    color: var(--chalk);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .av-bar .sp {
    flex: 1;
  }
  .btn {
    height: 28px;
    padding: 0 10px;
    border-radius: 2px;
    border: 1px solid var(--seam-2);
    background: var(--paper);
    color: var(--chalk);
    font: 500 12px/1 var(--f-ui);
    cursor: pointer;
  }
  .btn:hover {
    background: var(--felt-2);
  }
  .md {
    margin: 0;
    padding: 22px 22px 30px;
    border: 1px solid var(--seam);
    border-radius: 0 0 4px 4px;
    background: var(--paper);
    font: 400 13px/1.75 var(--f-mono);
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--chalk);
    min-height: 200px;
  }
</style>
