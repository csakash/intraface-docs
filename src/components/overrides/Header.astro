---
import Search from './Search.astro';
import ThemeSelect from './ThemeSelect.astro';
import ViewToggle from '../ViewToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const NAV = [
  { label: 'Guides', href: `${base}/`, on: path === `${base}/` },
  { label: 'CLI', href: `${base}/reference/cli/`, on: path.startsWith(`${base}/reference/cli`) },
  { label: 'MCP', href: `${base}/reference/mcp/`, on: path.startsWith(`${base}/reference/mcp`) },
  { label: 'HTTP API', href: `${base}/reference/api/`, on: path.startsWith(`${base}/reference/api`) },
];
---

<div class="ifc-header">
  <a class="logo" href={`${base}/`} aria-label="Intraface docs home">
    <svg viewBox="0 0 22 22" aria-hidden="true"
      ><rect x="1" y="1" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"></rect><rect
        x="8"
        y="8"
        width="13"
        height="13"
        fill="currentColor"></rect></svg
    >
    <span>Intraface</span>
    <small>docs</small>
  </a>
  <nav class="top" aria-label="Sections">
    {NAV.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <span class="spacer"></span>
  <Search />
  <ViewToggle />
  <span class="wide"><ThemeSelect /></span>
  <a class="btn primary wide" href="https://app.intraface.cc">Open app</a>
  <span class="progress" aria-hidden="true"></span>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('.ifc-header .progress');
  let ticking = false;
  const paint = () => {
    ticking = false;
    const h = document.documentElement;
    const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
    if (bar) bar.style.transform = `scaleX(${p})`;
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    },
    { passive: true },
  );
  paint();
</script>

<style>
  .ifc-header {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 19px/1 var(--f-display);
    letter-spacing: -0.035em;
    text-decoration: none;
    color: var(--chalk);
    flex: none;
  }
  .logo svg {
    width: 20px;
    height: 20px;
  }
  .logo small {
    font: 500 11px/1 var(--f-mono);
    letter-spacing: 0;
    color: var(--dust);
    border: 1px dashed var(--seam-2);
    padding: 3px 6px;
    border-radius: 2px;
  }
  .top {
    display: flex;
    gap: 2px;
    margin-left: 10px;
  }
  .top a {
    text-decoration: none;
    font-size: 13px;
    color: var(--dust);
    padding: 6px 10px;
    border-radius: 2px;
    transition:
      color 160ms,
      background 160ms;
  }
  .top a:hover {
    color: var(--chalk);
    background: var(--felt-2);
  }
  .top a[aria-current] {
    color: var(--chalk);
    font-weight: 500;
  }
  .spacer {
    flex: 1;
  }
  .btn {
    height: 32px;
    padding: 0 13px;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border: 1px solid var(--thread);
    background: var(--thread);
    color: var(--on-thread);
    font-weight: 500;
    font-size: 13px;
    text-decoration: none;
    transition:
      opacity 160ms,
      transform 160ms var(--ease-out);
  }
  .btn:hover {
    opacity: 0.88;
  }
  .btn:active {
    transform: scale(0.97);
  }
  .wide {
    display: inline-flex;
  }
  .progress {
    position: absolute;
    left: calc(-1 * var(--sl-nav-pad-x));
    right: calc(-1 * var(--sl-nav-pad-x));
    bottom: calc(-1 * var(--sl-nav-pad-y) - 1px);
    height: 2px;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: var(--thread);
    pointer-events: none;
  }
  @media (max-width: 50rem) {
    .top,
    .wide,
    .logo small {
      display: none;
    }
    .ifc-header {
      gap: 6px;
      /* Room for Starlight's menu button, which sits over the header's right edge on narrow screens. */
      padding-inline-end: 2.5rem;
    }
  }
  @media (max-width: 64rem) {
    .top {
      display: none;
    }
  }
</style>
